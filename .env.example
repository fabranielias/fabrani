# Banco de dados (Supabase Postgres ou qualquer PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:senha@db.<projeto>.supabase.co:5432/postgres"

# Sessão (obrigatório em produção) — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# Seed do usuário administrador
SEED_ADMIN_EMAIL="contato@fabrani.com.br"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"

# Supabase Storage (opcional; sem isso os uploads vão para ./storage no disco local)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documentos"

# Sócrates (opcional; sem a chave o agente segue ativo nas camadas determinísticas)
ANTHROPIC_API_KEY=""
# Protege o cron /api/cron/socrates
CRON_SECRET=""
